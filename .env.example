# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id

# Database (PostgreSQL)
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://budget:your_secure_password_here@budget_postgres:5432/budget_bot

# Google Sheets - Финансы (опционально, для экспорта)
GOOGLE_SHEETS_ID=your_finance_spreadsheet_id
GOOGLE_SHEETS_FINANCE_ID=your_finance_spreadsheet_id
GOOGLE_CREDENTIALS_FILE=google_credentials.json

# Google Sheets - Тренировки (опционально)
GOOGLE_SHEETS_WORKOUT_ID=your_workout_spreadsheet_id

# DeepSeek AI (для советника)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Mini App
MINI_APP_URL=https://budget-bot.duckdns.org:8443

# Настройки пользователя
USER_TIMEZONE=Europe/Minsk
USER_NAME=Артур
